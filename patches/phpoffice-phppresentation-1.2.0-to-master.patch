+    /**
+     * Returns the spreadsheet column name for a 1-based column index
+     * (1 => A, 2 => B, 26 => Z, 27 => AA).
+     */
+    private function getColumnName(int $index): string
+    {
+        $name = '';
+        while ($index > 0) {
+            $modulo = ($index - 1) % 26;
+            $name = chr(65 + $modulo) . $name;
+            $index = intdiv($index - $modulo, 26);
+        }
+
+        return $name;
+    }
 }
